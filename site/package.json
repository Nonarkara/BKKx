{
  "name": "bkkx-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "npm ls --depth=0",
    "dev": "npm run data:publish && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run data:rowhouses && npm run data:heroes && npm run data:hide && npm run data:forms && npm run data:strips && npm run data:candidates && npm run data:evidence && npm run data:pressure && npm run data:spine && npm run data:pois && npm run data:manifest && npm run data:publish && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/fix-asset-manifest.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run verify:repo && node --experimental-strip-types --test tests/flood-evidence.test.mjs tests/heritage-forms.test.mjs tests/old-town-cover.test.mjs tests/immutable-data.test.mjs tests/shophouse-typology.test.mjs tests/maplibre-runtime.test.mjs tests/maplibre-labels.test.mjs tests/build-id.test.mjs && node --experimental-strip-types --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "data:rowhouses": "node --experimental-strip-types scripts/export-rowhouse-data.mjs",
    "data:heroes": "python3 scripts/build-hero-monuments.py",
    "data:hide": "python3 scripts/hide-under-heroes.py",
    "data:forms": "node --experimental-strip-types scripts/build-heritage-forms.mjs",
    "data:strips": "python3 scripts/flag-row-strips.py",
    "data:candidates": "python3 scripts/flag-candidates-over-detail.py",
    "data:evidence": "node --experimental-strip-types scripts/build-evidence-tally.mjs",
    "data:pressure": "node --experimental-strip-types scripts/verify-shophouse-pressure.mjs",
    "data:spine": "node --experimental-strip-types scripts/verify-shophouse-spine.mjs",
    "data:pois": "node --experimental-strip-types scripts/verify-pois.mjs",
    "data:manifest": "node --experimental-strip-types scripts/build-dataset-manifest.mjs",
    "data:publish": "node scripts/publish-immutable-data.mjs",
    "data:rowhouse-footprints": "npm run data:rowhouses && python3 scripts/build-rowhouse-footprints.py",
    "verify:repo": "node scripts/verify-repo.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.2"
  },
  "type": "module"
}
