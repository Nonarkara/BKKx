{
  "name": "site-creator-vinext-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run data:rowhouses && npm run data:heroes && npm run data:hide && npm run data:forms && npm run data:strips && npm run data:candidates && npm run data:evidence && npm run data:pressure && npm run data:spine && npm run data:pois && npm run data:manifest && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/fix-asset-manifest.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/flood-evidence.test.mjs tests/heritage-forms.test.mjs && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "data:rowhouses": "node --experimental-strip-types scripts/export-rowhouse-data.mjs",
    "data:heroes": "python3 scripts/build-hero-monuments.py",
    "data:hide": "python3 scripts/hide-under-heroes.py",
    "data:forms": "node --experimental-strip-types scripts/build-heritage-forms.mjs",
    "data:strips": "python3 scripts/flag-row-strips.py",
    "data:candidates": "python3 scripts/flag-candidates-over-detail.py",
    "data:evidence": "node --experimental-strip-types scripts/build-evidence-tally.mjs",
    "data:pressure": "node --experimental-strip-types scripts/verify-shophouse-pressure.mjs",
    "data:spine": "node --experimental-strip-types scripts/verify-shophouse-spine.mjs",
    "data:pois": "node --experimental-strip-types scripts/verify-pois.mjs",
    "data:manifest": "node --experimental-strip-types scripts/build-dataset-manifest.mjs",
    "data:rowhouse-footprints": "npm run data:rowhouses && python3 scripts/build-rowhouse-footprints.py"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "6.11.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261002.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "type": "module"
}
