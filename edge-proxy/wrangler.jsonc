{
  "$schema": "../site/node_modules/wrangler/config-schema.json",
  "name": "bkkx-domain-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  // klx.nonarkara.org only. This branch is the Kuala Lumpur twin.
  "routes": [
    {
      "pattern": "klx.nonarkara.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
